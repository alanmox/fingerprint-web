# MySQL (e.g. Aiven). Place the service's CA certificate at ./certificates/aiven-ca.pem
DATABASE_URL=mysql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?sslcert=./certificates/aiven-ca.pem&sslaccept=strict
SESSION_SECRET=replace-with-a-long-random-string

# Bootstrap admin account created by `npm run prisma:seed`
ADMIN_SEED_EMAIL=ubuntu@mloganzila.or.tz
ADMIN_SEED_PASSWORD=Dict#@2018

# Mantra MFS500 fingerprint scanner (local, non-Aadhaar capture + identify service)
# The app server must run on the same machine as the scanner, since these
# calls hit 127.0.0.1. "live" talks to the real local service; anything else
# uses an in-memory mock so the rest of the app can be built/tested without
# hardware. Verify paths/method against your installed service if capture or
# identify requests fail — see lib/fingerprintDevice/localService.ts.
MANTRA_MODE=mock
MANTRA_LOCAL_BASE_URL=https://127.0.0.1:11100
MANTRA_LOCAL_INFO_PATH=/device/info
MANTRA_LOCAL_ENROLL_PATH=/device/enroll
MANTRA_LOCAL_IDENTIFY_PATH=/device/identify
MANTRA_LOCAL_TIMEOUT_MS=10000
MANTRA_LOCAL_ALLOW_SELF_SIGNED=true
MANTRA_LOCAL_MATCH_THRESHOLD=60
